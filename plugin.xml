<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         point="org.eclipse.ui.views">
      <category
            id="com.sap.cleancore.analyzer.category"
            name="SAP Clean Core">
      </category>
      <view
            id="com.sap.cleancore.analyzer.analyzerView"
            name="Clean Core Analyzer"
            category="com.sap.cleancore.analyzer.category"
            class="com.sap.cleancore.analyzer.ui.CleanCoreAnalyzerView"
            allowMultiple="false"
            restorable="true">
      </view>
      <view
            id="com.sap.cleancore.analyzer.mappingView"
            name="Mapping Maintenance"
            category="com.sap.cleancore.analyzer.category"
            class="com.sap.cleancore.analyzer.ui.MappingMaintenanceView"
            allowMultiple="false"
            restorable="true">
      </view>
   </extension>
   <extension
         point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension
            targetID="org.eclipse.ui.resourcePerspective">
         <view
               id="com.sap.cleancore.analyzer.analyzerView"
               relative="org.eclipse.ui.views.ContentOutline"
               relationship="stack">
         </view>
      </perspectiveExtension>
   </extension>
   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="com.sap.cleancore.analyzer.preferences"
            name="Clean Core Analyzer"
            class="com.sap.cleancore.analyzer.preferences.CleanCorePreferencePage">
      </page>
   </extension>
   <extension point="org.eclipse.ui.commands">
      <category
            id="com.sap.cleancore.analyzer.commands"
            name="Clean Core">
      </category>
      <command
            id="com.sap.cleancore.analyzer.analyzeCurrentFile"
            name="Analyze Current File"
            description="Analyse the currently open ABAP source file for clean-core findings."
            categoryId="com.sap.cleancore.analyzer.commands">
      </command>
      <command
            id="com.sap.cleancore.analyzer.analyzeAllOpenEditors"
            name="Analyze All Open Editors"
            description="Analyse every ABAP source file open in this workbench in one shot."
            categoryId="com.sap.cleancore.analyzer.commands">
      </command>
      <command
            id="com.sap.cleancore.analyzer.analyzeSelectedPackage"
            name="Analyze Selected Package"
            description="Open every Z*/Y* child of the selected ADT package in editors (priming the ADT cache) and analyse them."
            categoryId="com.sap.cleancore.analyzer.commands">
      </command>
      <command
            id="com.sap.cleancore.analyzer.analyzeDiskFiles"
            name="Analyze ABAP Files from Disk..."
            description="Pick local ABAP source files via a file dialog and analyse them - no SAP connection required (R/3 offline workflow)."
            categoryId="com.sap.cleancore.analyzer.commands">
      </command>
      <command
            id="com.sap.cleancore.analyzer.analyzeFolder"
            name="Analyze Folder (Offline)"
            description="Recursively analyse a folder of dumped ABAP source files (with optional metadata.json) - no SAP/ADT connection required. The offline counterpart of Analyze Selected Package for old systems."
            categoryId="com.sap.cleancore.analyzer.commands">
      </command>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="com.sap.cleancore.analyzer.analyzeCurrentFile"
            class="com.sap.cleancore.analyzer.handlers.AnalyzeCurrentFileHandler">
      </handler>
      <handler
            commandId="com.sap.cleancore.analyzer.analyzeAllOpenEditors"
            class="com.sap.cleancore.analyzer.handlers.AnalyzeAllOpenEditorsHandler">
      </handler>
      <handler
            commandId="com.sap.cleancore.analyzer.analyzeSelectedPackage"
            class="com.sap.cleancore.analyzer.handlers.AnalyzeSelectedPackageHandler">
      </handler>
      <handler
            commandId="com.sap.cleancore.analyzer.analyzeDiskFiles"
            class="com.sap.cleancore.analyzer.handlers.AnalyzeDiskFilesHandler">
      </handler>
      <handler
            commandId="com.sap.cleancore.analyzer.analyzeFolder"
            class="com.sap.cleancore.analyzer.handlers.AnalyzeFolderHandler">
      </handler>
   </extension>
   <extension point="org.eclipse.ui.bindings">
      <key
            sequence="M1+M2+K"
            commandId="com.sap.cleancore.analyzer.analyzeCurrentFile"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration">
      </key>
   </extension>
   <extension point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="menu:org.eclipse.ui.main.menu?after=window">
         <menu
               id="com.sap.cleancore.analyzer.menu"
               label="Clean Core">
            <command
                  commandId="com.sap.cleancore.analyzer.analyzeCurrentFile"
                  label="Analyze Current File"
                  style="push">
            </command>
            <command
                  commandId="com.sap.cleancore.analyzer.analyzeAllOpenEditors"
                  label="Analyze All Open Editors"
                  style="push">
            </command>
            <command
                  commandId="com.sap.cleancore.analyzer.analyzeDiskFiles"
                  label="Analyze ABAP Files from Disk..."
                  style="push">
            </command>
            <command
                  commandId="com.sap.cleancore.analyzer.analyzeFolder"
                  label="Analyze Folder (Offline)..."
                  style="push">
            </command>
         </menu>
      </menuContribution>
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <menu
               id="com.sap.cleancore.analyzer.popupMenu"
               label="Clean Core">
            <command
                  commandId="com.sap.cleancore.analyzer.analyzeSelectedPackage"
                  label="Analyze Selected Package"
                  style="push">
            </command>
            <command
                  commandId="com.sap.cleancore.analyzer.analyzeFolder"
                  label="Analyze Folder (Offline)"
                  style="push">
            </command>
         </menu>
      </menuContribution>
   </extension>
</plugin>
