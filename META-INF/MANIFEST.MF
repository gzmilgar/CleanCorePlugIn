Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: SAP Clean Core Analyzer
Bundle-SymbolicName: com.sap.cleancore;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Activator: com.sap.cleancore.Activator
Bundle-Vendor: Clean Core
Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.eclipse.jface,
 org.eclipse.ui.forms,
 org.eclipse.core.resources,
 org.eclipse.jface.text,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.ui.editors,
 org.eclipse.ui.ide
Bundle-RequiredExecutionEnvironment: JavaSE-11
Automatic-Module-Name: com.sap.cleancore
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .
Export-Package: com.sap.cleancore,
 com.sap.cleancore.analyzer.model,
 com.sap.cleancore.analyzer.mapping,
 com.sap.cleancore.analyzer.effort,
 com.sap.cleancore.analyzer.analyzers,
 com.sap.cleancore.analyzer.utils,
 com.sap.cleancore.analyzer.data
